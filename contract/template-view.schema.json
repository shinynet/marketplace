{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "view": {
      "type": "string",
      "const": "template"
    },
    "record": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-f0-9]{24}$"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "revision": {
          "type": "string",
          "pattern": "^template:[12]:[a-f0-9]{64}$"
        },
        "exercises": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "exerciseId": {
                "type": "string"
              },
              "exerciseName": {
                "type": "string"
              },
              "modality": {
                "type": "string",
                "enum": [
                  "resistance",
                  "cardio",
                  "mobility"
                ]
              },
              "order": {
                "type": "number"
              },
              "section": {
                "type": "string",
                "enum": [
                  "warmup",
                  "main",
                  "cooldown"
                ]
              },
              "comments": {
                "type": "string"
              },
              "unitOverrides": {
                "type": "object",
                "properties": {
                  "load": {
                    "type": "string",
                    "enum": [
                      "lb",
                      "kg"
                    ]
                  },
                  "distance": {
                    "type": "string",
                    "enum": [
                      "m",
                      "km",
                      "mi",
                      "ft",
                      "yd"
                    ]
                  },
                  "pace": {
                    "type": "string",
                    "enum": [
                      "s/km",
                      "s/mi",
                      "s/500m",
                      "s/100m",
                      "s/100yd"
                    ]
                  },
                  "speed": {
                    "type": "string",
                    "enum": [
                      "km/h",
                      "mph"
                    ]
                  },
                  "elevation": {
                    "type": "string",
                    "enum": [
                      "m",
                      "ft"
                    ]
                  }
                }
              },
              "resolvedUnits": {
                "type": "object",
                "properties": {
                  "load": {
                    "type": "string",
                    "enum": [
                      "lb",
                      "kg"
                    ]
                  },
                  "distance": {
                    "type": "string",
                    "enum": [
                      "m",
                      "km",
                      "mi",
                      "ft",
                      "yd"
                    ]
                  },
                  "pace": {
                    "type": "string",
                    "enum": [
                      "s/km",
                      "s/mi",
                      "s/500m",
                      "s/100m",
                      "s/100yd"
                    ]
                  },
                  "speed": {
                    "type": "string",
                    "enum": [
                      "km/h",
                      "mph"
                    ]
                  },
                  "elevation": {
                    "type": "string",
                    "enum": [
                      "m",
                      "ft"
                    ]
                  }
                },
                "required": [
                  "load",
                  "distance",
                  "pace",
                  "speed",
                  "elevation"
                ]
              },
              "sets": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "category": {
                      "type": "string",
                      "enum": [
                        "warmup",
                        "working",
                        "dropset",
                        "backoff",
                        "topset",
                        "amrap",
                        "interval",
                        "recovery",
                        "cooldown"
                      ]
                    },
                    "comments": {
                      "type": "string"
                    },
                    "plannedPace": {
                      "type": "object",
                      "properties": {
                        "value": {
                          "type": "number",
                          "minimum": 0
                        },
                        "unit": {
                          "type": "string",
                          "enum": [
                            "s/km",
                            "s/mi",
                            "s/500m",
                            "s/100m",
                            "s/100yd"
                          ]
                        }
                      },
                      "required": [
                        "value",
                        "unit"
                      ]
                    },
                    "plannedWeight": {
                      "type": "object",
                      "properties": {
                        "value": {
                          "type": "number",
                          "minimum": 0
                        },
                        "unit": {
                          "type": "string",
                          "enum": [
                            "lb",
                            "kg"
                          ]
                        }
                      },
                      "required": [
                        "value",
                        "unit"
                      ]
                    },
                    "plannedDuration": {
                      "type": "number",
                      "minimum": 0
                    },
                    "plannedDistance": {
                      "type": "object",
                      "properties": {
                        "value": {
                          "type": "number",
                          "minimum": 0
                        },
                        "unit": {
                          "type": "string",
                          "enum": [
                            "m",
                            "km",
                            "mi",
                            "ft",
                            "yd"
                          ]
                        }
                      },
                      "required": [
                        "value",
                        "unit"
                      ]
                    },
                    "plannedReps": {
                      "type": "object",
                      "properties": {
                        "min": {
                          "type": "number"
                        },
                        "max": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "min",
                        "max"
                      ]
                    },
                    "restTarget": {
                      "type": "number",
                      "minimum": 0
                    },
                    "rirTarget": {
                      "type": "number",
                      "minimum": 0
                    },
                    "plannedAmrap": {
                      "type": "boolean"
                    },
                    "plannedRpe": {
                      "type": "number",
                      "minimum": 0
                    },
                    "plannedHrZone": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 5
                    },
                    "tempo": {
                      "type": "string"
                    },
                    "side": {
                      "type": "string",
                      "enum": [
                        "left",
                        "right",
                        "both"
                      ]
                    },
                    "prs": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "enum": [
                              "weight",
                              "oneRm",
                              "volume",
                              "reps"
                            ]
                          },
                          "weight": {
                            "type": "object",
                            "properties": {
                              "value": {
                                "type": "number",
                                "minimum": 0
                              },
                              "unit": {
                                "type": "string",
                                "enum": [
                                  "lb",
                                  "kg"
                                ]
                              }
                            },
                            "required": [
                              "value",
                              "unit"
                            ]
                          },
                          "reps": {
                            "type": "number"
                          },
                          "first": {
                            "type": "boolean"
                          }
                        },
                        "required": [
                          "type",
                          "weight"
                        ]
                      }
                    }
                  },
                  "required": [
                    "id",
                    "category"
                  ]
                }
              },
              "activities": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "rest",
                        "water_break",
                        "stretching",
                        "warmup",
                        "cooldown",
                        "custom"
                      ]
                    },
                    "title": {
                      "type": "string"
                    },
                    "detail": {
                      "type": "string"
                    },
                    "notes": {
                      "type": "string"
                    },
                    "durationTarget": {
                      "type": "number",
                      "minimum": 0
                    },
                    "order": {
                      "type": "number"
                    },
                    "section": {
                      "type": "string",
                      "enum": [
                        "warmup",
                        "main",
                        "cooldown"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "kind",
                    "title",
                    "order"
                  ]
                }
              }
            },
            "required": [
              "id",
              "exerciseId",
              "exerciseName",
              "modality",
              "order",
              "sets"
            ]
          }
        },
        "activities": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "rest",
                  "water_break",
                  "stretching",
                  "warmup",
                  "cooldown",
                  "custom"
                ]
              },
              "title": {
                "type": "string"
              },
              "detail": {
                "type": "string"
              },
              "notes": {
                "type": "string"
              },
              "durationTarget": {
                "type": "number",
                "minimum": 0
              },
              "order": {
                "type": "number"
              },
              "section": {
                "type": "string",
                "enum": [
                  "warmup",
                  "main",
                  "cooldown"
                ]
              }
            },
            "required": [
              "id",
              "kind",
              "title",
              "order"
            ]
          }
        },
        "executionGroups": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "superset",
                  "circuit"
                ]
              },
              "members": {
                "minItems": 2,
                "maxItems": 10,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "workoutExerciseId": {
                      "type": "string"
                    },
                    "setIds": {
                      "minItems": 1,
                      "maxItems": 100,
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "workoutExerciseId",
                    "setIds"
                  ]
                }
              }
            },
            "required": [
              "id",
              "kind",
              "members"
            ]
          }
        }
      },
      "required": [
        "id",
        "name",
        "revision",
        "exercises"
      ]
    },
    "related": {
      "type": "object",
      "properties": {
        "exercises": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "loadShape": {
                "type": "string",
                "enum": [
                  "external",
                  "added",
                  "none"
                ]
              },
              "unavailable": {
                "type": "boolean"
              },
              "nameDe": {
                "type": "string"
              },
              "tracksWeight": {
                "type": "boolean"
              },
              "tracksReps": {
                "type": "boolean"
              },
              "tracksTime": {
                "type": "boolean"
              },
              "tracksDistance": {
                "type": "boolean"
              },
              "description": {
                "type": "string"
              },
              "instructions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "instructionsDe": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "id"
            ]
          }
        }
      },
      "required": [
        "exercises"
      ]
    },
    "presentation": {
      "type": "object",
      "properties": {
        "locale": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "unitSystem": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "metric",
                "imperial"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "theme": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "system",
                "light",
                "dark"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "skin": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "calm",
                "cyanotype",
                "camellia"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "locale",
        "unitSystem",
        "theme",
        "skin"
      ]
    }
  },
  "required": [
    "view",
    "record",
    "related",
    "presentation"
  ]
}
